[gd_resource type="Resource" script_class="ScreenData" format=3]

[ext_resource type="Script" path="res://systems/ui/screen_data.gd" id="1_screen"]

[resource]
script = ExtResource("1_screen")
scene = "res://systems/game/hub_session.tscn"
root = true
captures_mouse = true
loading_screen = &"loading"
title = "Lantern Post"
tips = PackedStringArray("Lantern Post is safe: no zombies come past the walls.", "Press F at the Deploy board by the gate to ready up. When everyone is ready, the squad deploys after 5 seconds.", "Changed your mind? Press F at the Deploy board again to cancel your ready.", "After a match, press Back to hub on the results screen to return to town with your squad.")
