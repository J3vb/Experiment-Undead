[gd_resource type="Resource" script_class="ScreenData" format=3]

[ext_resource type="Script" path="res://systems/ui/screen_data.gd" id="1_screen"]

[resource]
script = ExtResource("1_screen")
scene = "res://systems/game/game_session.tscn"
root = true
captures_mouse = true
loading_screen = &"loading"
title = "Halcyon Labs"
tips = PackedStringArray("Every hit pays points. A headshot kill pays the most.", "Loot is yours alone: only you see your drops, and everything in your Pack goes home with you.", "The Specimen Vault gives a random gun. It might be the best thing you find all run.", "From round 10, every 5 rounds, an exfil hatch opens. Hold it for 60 seconds to leave with a bonus.", "Serums from the MedDispenser last until you go down.", "Opening doors spreads the zombies out. Pick your route before you spend.")
