[gd_resource type="Resource" script_class="SettingData" format=3]

[ext_resource type="Script" path="res://systems/ui/setting_data.gd" id="1_setting"]

[resource]
script = ExtResource("1_setting")
page = &"graphics"
section = &"graphics"
key = &"aa"
label = "Anti-aliasing"
hint = "Smooths jagged edges. MSAA is sharpest; TAA is smoothest but can blur in motion."
kind = &"choice"
options = Array[String](["Off", "FXAA", "MSAA 2x + FXAA", "MSAA 4x + FXAA", "TAA"])
order = 90
