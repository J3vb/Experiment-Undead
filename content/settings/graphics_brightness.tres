[gd_resource type="Resource" script_class="SettingData" format=3]

[ext_resource type="Script" path="res://systems/ui/setting_data.gd" id="1_setting"]

[resource]
script = ExtResource("1_setting")
page = &"graphics"
section = &"graphics"
key = &"brightness"
label = "Brightness"
hint = "Raise it until dark corners show detail without looking grey. 100% is the intended look."
kind = &"slider"
min_value = 0.5
max_value = 1.5
step = 0.05
display_scale = 100.0
order = 170
