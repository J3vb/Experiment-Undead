[gd_resource type="Resource" script_class="SettingData" format=3]

[ext_resource type="Script" path="res://systems/ui/setting_data.gd" id="1_setting"]

[resource]
script = ExtResource("1_setting")
page = &"graphics"
section = &"graphics"
key = &"anisotropic"
label = "Texture filtering"
hint = "Keeps floors and walls sharp at steep angles."
kind = &"choice"
options = PackedStringArray("Off", "2x", "4x", "8x", "16x")
order = 160
