[gd_resource type="Resource" script_class="SettingData" format=3]

[ext_resource type="Script" path="res://systems/ui/setting_data.gd" id="1_setting"]

[resource]
script = ExtResource("1_setting")
page = &"accessibility"
section = &"accessibility"
key = &"damage_numbers"
label = "Damage numbers"
hint = "Floating damage over enemies you hit. Crits only shows headshots until crits exist."
kind = &"choice"
options = Array[String](["Off", "Crits only", "All"])
option_values = Array[String](["off", "crits", "all"])
order = 60
