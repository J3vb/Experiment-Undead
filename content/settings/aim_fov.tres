[gd_resource type="Resource" script_class="SettingData" format=3]

[ext_resource type="Script" path="res://systems/ui/setting_data.gd" id="1_setting"]

[resource]
script = ExtResource("1_setting")
page = &"aim"
section = &"aim"
key = &"fov"
label = "Field of view"
hint = "How wide you see, in degrees across a 16:9 screen. Wider shows more of your surroundings."
kind = &"slider"
min_value = 70
max_value = 120
step = 1
order = 10
