[gd_resource type="Resource" script_class="SettingData" format=3]

[ext_resource type="Script" path="res://systems/ui/setting_data.gd" id="1_setting"]

[resource]
script = ExtResource("1_setting")
page = &"graphics"
section = &"graphics"
key = &"window_size"
label = "Window size"
hint = "Size of the game window in Windowed mode. Borderless and Fullscreen always use the screen's size."
kind = &"choice"
options = Array[String](["1280 x 720", "1600 x 900", "1920 x 1080", "2560 x 1440", "3840 x 2160"])
order = 30
needs_confirm = true
