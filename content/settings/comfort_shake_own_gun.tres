[gd_resource type="Resource" script_class="SettingData" format=3]

[ext_resource type="Script" path="res://systems/ui/setting_data.gd" id="1_setting"]

[resource]
script = ExtResource("1_setting")
page = &"comfort"
section = &"comfort"
key = &"shake_own_gun"
label = "Camera shake from your gun"
hint = "How much the view kicks, shakes and zooms when you fire. Never changes where your bullets go."
kind = &"slider"
min_value = 0.0
max_value = 1.0
step = 0.05
display_scale = 100.0
order = 60
