[gd_resource type="Resource" script_class="SettingData" format=3]

[ext_resource type="Script" path="res://systems/ui/setting_data.gd" id="1_setting"]

[resource]
script = ExtResource("1_setting")
page = &"aim"
section = &"aim"
key = &"ads_sensitivity_multiplier"
label = "Aiming sensitivity"
hint = "Mouse speed while aiming down sights, as a share of normal speed."
kind = &"slider"
min_value = 0.2
max_value = 2.0
step = 0.05
display_scale = 100.0
order = 30
