[gd_resource type="Resource" script_class="SettingData" format=3]

[ext_resource type="Script" path="res://systems/ui/setting_data.gd" id="1_setting"]

[resource]
script = ExtResource("1_setting")
page = &"comfort"
section = &"comfort"
key = &"head_bob"
label = "Head bob"
hint = "How much the view bobs while you walk and run. Lower it if moving makes you feel sick."
kind = &"slider"
min_value = 0.0
max_value = 1.0
step = 0.05
display_scale = 100.0
order = 10
