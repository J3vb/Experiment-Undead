* text=auto eol=lf
*.wav binary
*.ogg binary
*.png binary
*.jpg binary
*.glb binary
*.ttf binary
*.otf binary

# Git LFS is planned for binaries (see docs/DECISIONS.md). The cloud build
# session cannot upload LFS objects yet, so these stay commented until the
# first push from a local machine. To switch on, uncomment and run
# `git lfs migrate import --include="*.wav,*.ogg,*.png,*.jpg,*.glb,*.ttf,*.otf" --everything`.
# *.wav filter=lfs diff=lfs merge=lfs -text
# *.ogg filter=lfs diff=lfs merge=lfs -text
# *.png filter=lfs diff=lfs merge=lfs -text
# *.jpg filter=lfs diff=lfs merge=lfs -text
# *.glb filter=lfs diff=lfs merge=lfs -text
# *.ttf filter=lfs diff=lfs merge=lfs -text
# *.otf filter=lfs diff=lfs merge=lfs -text
