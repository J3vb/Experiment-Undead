{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Experiment Undead Launcher",
  "version": "0.0.0",
  "identifier": "com.experimentundead.launcher",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Experiment Undead",
        "width": 1280,
        "height": 760,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
