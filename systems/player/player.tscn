properties/3/replication_mode = 2
properties/4/path = NodePath("Body/BodyAnimator:held_weapon")
properties/4/spawn = true
properties/4/replication_mode = 2
properties/5/path = NodePath("Body/BodyAnimator:reload_time")
properties/5/spawn = true
properties/5/replication_mode = 2

[sub_resource type="CapsuleShape3D" id="capsule"]
radius = 0.4
height = 1.8

[node name="Player" type="CharacterBody3D"]
script = ExtResource("1")
mantle_rules = ExtResource("12_mantle")

[node name="CollisionShape3D" type="CollisionShape3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.9, 0)
shape = SubResource("capsule")

[node name="Head" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.6, 0)
script = ExtResource("2")
rules = ExtResource("feel_rules")

[node name="RecoilPivot" type="Node3D" parent="Head"]

[node name="Camera3D" type="Camera3D" parent="Head/RecoilPivot"]
current = true
fov = 78.0
near = 0.03
far = 300.0

[node name="WeaponHolder" type="Node3D" parent="Head/RecoilPivot/Camera3D"]
script = ExtResource("3")

[node name="Flashlight" type="SpotLight3D" parent="Head/RecoilPivot/Camera3D"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.3, -0.2, -0.1)
light_color = Color(1, 0.95, 0.85, 1)
light_energy = 3.0
light_volumetric_fog_energy = 0.6
shadow_enabled = true
spot_range = 32.0
spot_attenuation = 1.2
spot_angle = 24.0
spot_angle_attenuation = 1.6

[node name="HealthComponent" type="Node" parent="."]
script = ExtResource("4")
regen_delay = 4.0
regen_per_second = 35.0

[node name="Wallet" type="Node" parent="."]
script = ExtResource("5")

[node name="LocalInput" type="Node" parent="."]
script = ExtResource("6")

[node name="HurtSound" type="AudioStreamPlayer" parent="."]
stream = ExtResource("7")
bus = &"Player"

[node name="Footsteps" parent="." instance=ExtResource("10_steps")]

[node name="Body" type="Node3D" parent="."]
rotation = Vector3(0, 3.14159265, 0)

[node name="Model" parent="Body" instance=ExtResource("8_body")]

[node name="GearRig" type="Node3D" parent="Body" node_paths=PackedStringArray("body")]
script = ExtResource("9_rig")
body = NodePath("..")

[node name="BodyAnimator" type="Node" parent="Body" node_paths=PackedStringArray("player", "model", "pitch_source")]
script = ExtResource("11_anim")
player = NodePath("../..")
model = NodePath("../Model")
pitch_source = NodePath("../../Head")

[node name="PoseSync" type="MultiplayerSynchronizer" parent="."]
replication_config = SubResource("pose_sync")
