reflected_light_source = 2
tonemap_mode = 4
tonemap_exposure = 1.05

[node name="PackCharacter" type="HBoxContainer"]
custom_minimum_size = Vector2(0, 340)
theme_override_constants/separation = 12
script = ExtResource("script")

[node name="Slots" type="GridContainer" parent="."]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(340, 0)
theme_override_constants/h_separation = 8
theme_override_constants/v_separation = 8
columns = 2

[node name="Preview" type="SubViewportContainer" parent="."]
layout_mode = 2
size_flags_horizontal = 3
stretch = true

[node name="Viewport" type="SubViewport" parent="Preview"]
unique_name_in_owner = true
msaa_3d = 2
size = Vector2i(300, 340)
own_world_3d = true
handle_input_locally = false
render_target_update_mode = 0

[node name="WorldEnvironment" type="WorldEnvironment" parent="Preview/Viewport"]
environment = SubResource("booth")

[node name="Key" type="DirectionalLight3D" parent="Preview/Viewport"]
rotation_degrees = Vector3(-40, -45, 0)
light_color = Color(1, 0.851, 0.627, 1)
light_energy = 1.15

[node name="Rim" type="OmniLight3D" parent="Preview/Viewport"]
