fov = 34.0
current = true

[node name="Turntable" type="Node3D" parent="Preview/Viewport"]
rotation_degrees = Vector3(0, -15, 0)

[node name="Body" parent="Preview/Viewport/Turntable" instance=ExtResource("body")]

[node name="GearRig" type="Node3D" parent="Preview/Viewport/Turntable" node_paths=PackedStringArray("body")]
