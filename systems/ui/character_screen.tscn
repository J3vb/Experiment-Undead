[gd_scene format=3]

[ext_resource type="Script" path="res://systems/gear/gear_rig.gd" id="rig"]
[ext_resource type="Theme" path="res://systems/ui/theme.tres" id="theme"]
[ext_resource type="PackedScene" path="res://assets/models/characters/player.glb" id="body"]
[ext_resource type="Script" path="res://systems/ui/character_screen.gd" id="script"]
[ext_resource type="Script" path="res://systems/ui/name_field.gd" id="name_field"]
[ext_resource type="PackedScene" path="res://systems/ui/item_tooltip.tscn" id="tooltip"]
[ext_resource type="Script" path="res://systems/ui/loadout_slots.gd" id="loadout_slots"]

[sub_resource type="StyleBoxFlat" id="panel"]
bg_color = Color(0.071, 0.102, 0.125, 0.94)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.173, 0.231, 0.267, 1)
content_margin_left = 18.0
content_margin_top = 18.0
content_margin_right = 18.0
content_margin_bottom = 18.0

[sub_resource type="Environment" id="booth"]
background_mode = 1
background_color = Color(0.039, 0.078, 0.086, 1)
ambient_light_source = 3
ambient_light_color = Color(0.72, 0.7, 0.66, 1)
ambient_light_energy = 0.55
reflected_light_source = 2
tonemap_mode = 4
tonemap_exposure = 1.05

[node name="CharacterScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("theme")
script = ExtResource("script")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2
color = Color(0.043, 0.063, 0.078, 1)

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
theme_override_constants/margin_left = 32
theme_override_constants/margin_top = 24
theme_override_constants/margin_right = 32
theme_override_constants/margin_bottom = 20

[node name="Layout" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 20

[node name="Header" type="HBoxContainer" parent="Margin/Layout"]
layout_mode = 2

[node name="Title" type="Label" parent="Margin/Layout/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 36
text = "Character"

[node name="Section" type="Label" parent="Margin/Layout/Header"]
layout_mode = 2
text = "Loadout and stash"
theme_override_colors/font_color = Color(0.561, 0.639, 0.659, 1)

[node name="Columns" type="HBoxContainer" parent="Margin/Layout"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 20

[node name="Loadout" type="PanelContainer" parent="Margin/Layout/Columns"]
layout_mode = 2
custom_minimum_size = Vector2(460, 0)
size_flags_horizontal = 3
size_flags_stretch_ratio = 1.1
theme_override_styles/panel = SubResource("panel")

[node name="Box" type="VBoxContainer" parent="Margin/Layout/Columns/Loadout"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Name" type="LineEdit" parent="Margin/Layout/Columns/Loadout/Box"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Your name. Other players see it in co-op."
focus_mode = 1
text = "Survivor"
placeholder_text = "Survivor"
script = ExtResource("name_field")
theme_override_font_sizes/font_size = 28

[node name="LoadoutSlots" type="HBoxContainer" parent="Margin/Layout/Columns/Loadout/Box"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 8
script = ExtResource("loadout_slots")

[node name="ArmourSlots" type="VBoxContainer" parent="Margin/Layout/Columns/Loadout/Box/LoadoutSlots"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Preview" type="SubViewportContainer" parent="Margin/Layout/Columns/Loadout/Box/LoadoutSlots"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(140, 270)
size_flags_horizontal = 3
size_flags_vertical = 3
stretch = true
mouse_filter = 0

[node name="Viewport" type="SubViewport" parent="Margin/Layout/Columns/Loadout/Box/LoadoutSlots/Preview"]
msaa_3d = 2
size = Vector2i(360, 350)
own_world_3d = true
handle_input_locally = false
render_target_update_mode = 4

[node name="WorldEnvironment" type="WorldEnvironment" parent="Margin/Layout/Columns/Loadout/Box/LoadoutSlots/Preview/Viewport"]
environment = SubResource("booth")

[node name="Key" type="DirectionalLight3D" parent="Margin/Layout/Columns/Loadout/Box/LoadoutSlots/Preview/Viewport"]
rotation_degrees = Vector3(-40, -45, 0)
light_color = Color(1, 0.851, 0.627, 1)
light_energy = 1.15

[node name="Rim" type="OmniLight3D" parent="Margin/Layout/Columns/Loadout/Box/LoadoutSlots/Preview/Viewport"]
position = Vector3(2, 2.6, -2)
light_color = Color(0.804, 0.933, 0.910, 1)
light_energy = 1.6
omni_range = 8.0

[node name="Camera" type="Camera3D" parent="Margin/Layout/Columns/Loadout/Box/LoadoutSlots/Preview/Viewport"]
position = Vector3(0, 1.05, 3.4)
fov = 36.0
current = true

[node name="Turntable" type="Node3D" parent="Margin/Layout/Columns/Loadout/Box/LoadoutSlots/Preview/Viewport"]
unique_name_in_owner = true
rotation_degrees = Vector3(0, -15, 0)

[node name="Body" parent="Margin/Layout/Columns/Loadout/Box/LoadoutSlots/Preview/Viewport/Turntable" instance=ExtResource("body")]

[node name="GearRig" type="Node3D" parent="Margin/Layout/Columns/Loadout/Box/LoadoutSlots/Preview/Viewport/Turntable" node_paths=PackedStringArray("body")]
unique_name_in_owner = true
script = ExtResource("rig")
body = NodePath("../Body")

[node name="KitSlots" type="VBoxContainer" parent="Margin/Layout/Columns/Loadout/Box/LoadoutSlots"]
layout_mode = 2
